import os
import re
import sqlite3
import threading
import time
from datetime import datetime

import requests
from flask import Flask, render_template, request

app = Flask(__name__)

BOT_TOKEN = os.environ.get("BOT_TOKEN", "")
ADMIN_CHAT_ID = os.environ.get("ADMIN_CHAT_ID", "")
DB_PATH = os.environ.get("DB_PATH", "orders.db")

BUNDLES = {
    "30go": {"name": "30 Go", "price": "3.50"},
    "10go": {"name": "10 Go", "price": "1.50"},
    "5go": {"name": "5 Go", "price": "0.90"}
}

def connect_db():
    db = sqlite3.connect(DB_PATH)
    db.row_factory = sqlite3.Row
    return db

def initialize_database():
    with connect_db() as db:
        db.execute("""
        CREATE TABLE IF NOT EXISTS orders (
            order_id TEXT PRIMARY KEY,
            phone TEXT,
            bundle TEXT,
            price TEXT,
            decision TEXT DEFAULT 'pending'
        )
        """)

def telegram_send(message):
    if not BOT_TOKEN or not ADMIN_CHAT_ID:
        return

    try:
        requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage",
            json={
                "chat_id": ADMIN_CHAT_ID,
                "text": message
            },
            timeout=15
        ).raise_for_status()
    except requests.RequestException as error:
        app.logger.error("Telegram error: %s", error)

def update_order(order_id, decision):
    with connect_db() as db:
        cursor = db.execute(
            "UPDATE orders SET decision=? WHERE order_id=? AND decision='pending'",
            (decision, order_id)
        )
        return cursor.rowcount > 0

def telegram_polling():
    if not BOT_TOKEN or not ADMIN_CHAT_ID:
        return

    # This demo uses Telegram long polling.
    try:
        requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/deleteWebhook",
            timeout=15
        )
    except requests.RequestException:
        pass

    offset = None

    while True:
        try:
            params = {"timeout": 25}
            if offset is not None:
                params["offset"] = offset

            result = requests.get(
                f"https://api.telegram.org/bot{BOT_TOKEN}/getUpdates",
                params=params,
                timeout=35
            ).json()

            for update in result.get("result", []):
                offset = update["update_id"] + 1
                message = update.get("message", {})
                chat_id = str(message.get("chat", {}).get("id", ""))

                if chat_id != str(ADMIN_CHAT_ID):
                    continue

                text = message.get("text", "").strip()
                parts = text.split()

                if text in ("/start", "/help"):
                    telegram_send(
                        "Website Admin Bot\n"
                        "/approve ORDER_ID\n"
                        "/reject ORDER_ID"
                    )

                elif len(parts) == 2 and parts[0] in ("/approve", "/reject"):
                    order_id = parts[1].upper()
                    decision = (
                        "approved" if parts[0] == "/approve"
                        else "rejected"
                    )

                    if update_order(order_id, decision):
                        telegram_send(
                            f"{decision.title()}: {order_id}"
                        )
                    else:
                        telegram_send(
                            "Order not found or already reviewed."
                        )

        except Exception as error:
            app.logger.error("Telegram polling error: %s", error)
            time.sleep(5)

initialize_database()

if BOT_TOKEN and ADMIN_CHAT_ID:
    threading.Thread(
        target=telegram_polling,
        daemon=True
    ).start()


@app.route("/")
def home():
    return render_template("index.html", bundles=BUNDLES)


@app.route("/order", methods=["POST"])
def create_order():
    phone = request.form.get("phone", "").strip()
    bundle_code = request.form.get("bundle", "")

    if not re.fullmatch(r"\+243[0-9]{9}", phone):
        return render_template(
            "index.html",
            bundles=BUNDLES,
            error="Enter a valid +243 phone number."
        ), 400

    bundle = BUNDLES.get(bundle_code)

    if not bundle:
        return "Invalid bundle", 400

    order_id = "ORD-" + datetime.now().strftime("%Y%m%d%H%M%S")

    with connect_db() as db:
        db.execute(
            """INSERT INTO orders
            (order_id, phone, bundle, price)
            VALUES (?, ?, ?, ?)""",
            (order_id, phone, bundle["name"], bundle["price"])
        )

    telegram_send(
        "NEW DEMO ORDER\n"
        f"Order: {order_id}\n"
        f"Phone: {phone}\n"
        f"Bundle: {bundle['name']}\n"
        f"Price: ${bundle['price']}\n\n"
        f"/approve {order_id}\n"
        f"/reject {order_id}\n\n"
        "Demo order only. No payment has been collected."
    )

    return render_template(
        "received.html",
        order_id=order_id
    )


@app.route("/health")
def health():
    return {"ok": True}


if __name__ == "__main__":
    app.run(
        host="0.0.0.0",
        port=int(os.environ.get("PORT", 10000))
    )
